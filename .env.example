# Copia este archivo como .env y completa los valores. .env NUNCA va a git.
# Las variables vacías cuentan como "no configurado" y se usa el valor por defecto.

# Carpeta raíz de los datos (bronze/, silver/, quarantine/)
PPA_DATA_DIR=data

# Nivel de logs: DEBUG, INFO, WARNING o ERROR
PPA_LOG_LEVEL=INFO

# Clave de la API del Coordinador (portal.api.coordinador.cl)
PPA_CEN_API_KEY=
